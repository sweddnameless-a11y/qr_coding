# Generate with:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MIREA_SESSION_KEYS=REPLACE_WITH_BASE64_32_BYTE_KEY

# Leave blank for local http://localhost:8000 development.
# Production MUST use your own HTTPS origin, with no trailing slash.
APP_ORIGIN=

# Use a persistent directory on your own host so encrypted sessions survive restarts.
DATA_DIR=./data
